@page "/"
@using Models
@rendermode InteractiveServer
@inject BusinessLogicLayer.IProductService ProductService

<h1>Product Information</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@(isEditing ? "Edit Product (ID: " + productModel.Id + ")" : "Add New Product")</h5>

        <div class="mb-3">
            <label class="form-label">Product Name</label>
            <input class="form-control" @bind="productModel.Name" placeholder="Enter product name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Price</label>
            <input class="form-control" type="number" @bind="productModel.Price" placeholder="Enter price" />
        </div>

        <button class="btn btn-primary" @onclick="SaveProduct">@(isEditing ? "Update" : "Add")</button>

        @if (isEditing)
        {
            <button class="btn btn-secondary ms-2" @onclick="CancelEdit">Cancel</button>
        }
    </div>
</div>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Price</th>
            <th style="width:180px">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in products)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>
                    <button class="btn btn-sm btn-warning" @onclick="() => EditProduct(item.Id)">Edit</button>
                    <button class="btn btn-sm btn-danger ms-1" @onclick="() => DeleteProduct(item.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    ProductModel productModel = new ProductModel();
    List<ProductModel> products = new List<ProductModel>();
    bool isEditing = false;
    string message = "";

    protected override void OnInitialized()
    {
        LoadProducts();
    }

    void LoadProducts()
    {
        try
        {
            products = ProductService.GetAllData() ?? new List<ProductModel>();
        }
        catch (Exception ex)
        {
            message = "Failed to load products: " + ex.Message;
        }
    }

    // Fixed: Changed to Task and added StateHasChanged() to force UI refreshes
    async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(productModel.Name))
        {
            message = "Product name is required.";
            return;
        }

        try
        {
            bool success;

            if (isEditing)
            {
                // Run on a separate thread task to prevent thread-locking your browser circuit
                success = await Task.Run(() => ProductService.UpdateData(productModel));
                message = success ? "Product updated successfully." : "Update failed.";
            }
            else
            {
                success = await Task.Run(() => ProductService.InsertData(productModel));
                message = success ? "Product added successfully." : "Insert failed.";
            }

            ResetForm();
            LoadProducts();
        }
        catch (Exception ex)
        {
            message = "Error saving product: " + ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    // Fixed: Changed to Task and added StateHasChanged()
    async Task EditProduct(int id)
    {
        try
        {
            var product = await Task.Run(() => ProductService.GetDataById(id));
            if (product != null)
            {
                productModel = product;
                isEditing = true;
                message = "";
            }
        }
        catch (Exception ex)
        {
            message = "Error fetching product details: " + ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    // Fixed: Changed to Task and added StateHasChanged()
    async Task DeleteProduct(int id)
    {
        try
        {
            bool success = await Task.Run(() => ProductService.DeleteData(id));
            message = success ? "Product deleted successfully." : "Delete failed.";
            LoadProducts();
        }
        catch (Exception ex)
        {
            message = "Error deleting product: " + ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    void CancelEdit()
    {
        ResetForm();
        message = "";
    }

    void ResetForm()
    {
        productModel = new ProductModel();
        isEditing = false;
    }
}
